# Firebase Realtime Database für den Live-Sync zum OBS-Overlay.
# Kopieren nach `.env` und mit den Werten aus der Firebase-Konsole füllen
# (Projekteinstellungen → Allgemein → Meine Apps → Web-App → SDK-Konfiguration).
# Leer lassen = App läuft rein lokal (LocalStorage), ohne Live-Sync.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.europe-west1.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=
